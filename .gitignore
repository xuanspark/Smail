# 统一输出目录：测试源码放 test，日志放 test-log，编译产物放 out
/out/
/test-log/
/test/archive/
/artifacts/
/dist/
/output/

# 本机运行根目录与人工证书输入，不匹配源码中的同名目录
/config/
/data/
/ssl/
/yunx-test/

# 后端配置目录混放源码与运行数据：只放行代码、文档和脱敏示例
/backend/config/*
!/backend/config/*.go
!/backend/config/*.md
!/backend/config/*.json.example
!/backend/config/dkim/
/backend/config/dkim/*
!/backend/config/dkim/README.md
!/backend/config/ssl/
/backend/config/ssl/*
!/backend/config/ssl/README.md

# 后端插件安装目录保留源码目录，其余视为运行时安装内容
/backend/plugins/*
!/backend/plugins/catalog/
!/backend/plugins/catalog/**

# Telegram 配置源码和示例可跟踪，真实配置与数据不上传
/plugins/pmail_telegram_push/config/*
!/plugins/pmail_telegram_push/config/*.go
!/plugins/pmail_telegram_push/config/*.json.example
!/plugins/pmail_telegram_push/config/README.md
/plugins/pmail_telegram_push/plugins/

# Go 嵌入中间文件，以及旧命令仍可能生成的构建目录
/backend/listen/http_server/dist/
/backend/cmd/smail/bundled/
/frontend/dist/
/frontend/dist-ssr/
/plugins/pmail_telegram_push/hook/dist/
/plugins/pmail_telegram_push/dist/
/plugins/pmail_telegram_push/dist-ssr/
/plugins/pmail_telegram_push/output/
/backend/*.exe
/backend/smail
/backend/smail-admin
/backend/smail-config
/backend/smail_linux_*
/backend/smail_windows_*
/backend/smail_mac_*
/backend/smail_darwin_*
/backend/smail-admin_linux_*
/backend/smail-admin_windows_*
/backend/smail-admin_mac_*
/backend/smail-admin_darwin_*
/backend/hooks/spam_block/export/export_linux_*
/backend/hooks/spam_block/export/export_windows_*
/backend/hooks/spam_block/export/export_mac_*
/plugins/spam_block/export/export_linux_*
/plugins/spam_block/export/export_windows_*
/plugins/spam_block/export/export_mac_*

# 历史扫描结果与本地调试辅助文件，不忽略正式测试源码
/backend/gosec-report
/backend/gosec-g104-current.json
/backend/utils/validation/test.tmp
/backend/.codex-smail-*
/.codex-edit-config.py
/.codex-cg*.patch
/.codex-smail-*
.tmp-*
*.log
*.pid

# 依赖、解释器缓存及覆盖率；不忽略 Go 测试或手写声明文件
node_modules/
__pycache__/
.pytest_cache/
*.pyc
*.pyo
*.tsbuildinfo
coverage/

# 本地数据库及 SQLite 附属文件
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal

# 本机环境变量与凭据文件；不使用全局 *.json、*.key 或 config 规则
.env
.env.local
.env.*.local
*_KEY
AURORA_SECRET

# 编辑器及操作系统缓存
.idea/
.DS_Store
Thumbs.db
Desktop.ini
